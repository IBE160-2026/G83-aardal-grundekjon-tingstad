# Copy to .env and fill in. .env is git-ignored: never commit real values.

# Database. The local value matches the Postgres in docker-compose.yml.
# Published: Supabase transaction pooler (port 6543, add ?sslmode=require) here, and the direct
# connection below. Set both only in Vercel and Supabase, scoped to Production (previews get no
# database), never in this file.
DATABASE_URL=postgres://flexpt:flexpt@localhost:5432/flexpt
# Direct connection used only for migrations. Leave empty locally to use DATABASE_URL.
DATABASE_DIRECT_URL=

# Better Auth. Required: the app stops with a clear error when it is missing.
# docker compose uses a local-only default when this is empty; for `npm run dev`/`npm start`
# set your own. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Published: the public URL of the app. When empty on Vercel, VERCEL_PROJECT_PRODUCTION_URL is used.
BETTER_AUTH_URL=http://localhost:3000

# Coach: demo (recorded answers, no key) or live (calls Claude with your own key).
COACH_MODE=demo
ANTHROPIC_API_KEY=
COACH_MODEL_ID=claude-haiku-5-5
COACH_DAILY_LIMIT=20

# Host ports for docker compose; change them if 5432 or 3000 is taken on your machine.
DB_PORT=5432
APP_PORT=3000
